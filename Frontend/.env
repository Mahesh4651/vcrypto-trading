# ──────────────────────────────────────────
# Set this to your EC2 public IP or domain
# Example: http://54.123.45.67  or  https://yourdomain.com
# ──────────────────────────────────────────
FRONTEND_URL=http://YOUR_EC2_PUBLIC_IP

# ──────────────────────────────────────────
# Database credentials (must match docker-compose postgres service)
# ──────────────────────────────────────────
POSTGRES_DB=vcrypt_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
